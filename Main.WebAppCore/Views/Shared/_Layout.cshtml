@{
    var theme = TenantSetter.CurrentTenant.TenantThemeModel;
}

<!doctype html>
<html lang="en">
<head>
     <style>
            :root {
                 /* bootstrap-reboot.css */
                /* site.css */
                /* header */
                --bs-gray-dark: "@theme.HeaderColor !important"; 
                /* #3b3c3d !important; */

                /* bootstrap-reboot.css */
                /* body */
                --bs-font-sans-serif: "@theme.FontStack  !important";

                 /* site.css */
                /* header .top-header .top-header .dropdown .dropdown-menu */
                /* color */
                /* .icon-button, color */
                /* bootstrap.css --bs-dropdown-color   */
                /* HeaderMenuColor */
                --bs-code-color: "@theme.LogoColor !important";
                /* "#3b3c3d !important"; */

                /* Body Backgroud */
                /* header .top-header */
                /* background-color */
                /* header .main-header */
                /* background-color */
                /* header .bottom-header .header-container */
                /* background-color */
                /* bootstrap-reboot.css */
                /* body kbd */
                /* BodyColor: */
                --bs-body-color: "@theme.BodyBackgroundColor  !important";
                /* #494d52 !important; */

                /* header .bottom-header .main-menu */
                /* MenuBackgroundColor */
                --bs-dropdown-bg: "@theme.MenuBackgroundColor !important";
                /* #240202 !important; */

                /* btn-primary */
                /* background-color */
                /* border-color */
                --bs-secondary-bg: "@theme.ButtonBGBorderColor  !important";
                
                /* site.css */
                /* header .dropdown li > a:hover  */
                --bs-black: "@theme.MenuItemHoverBGColor !important";
                /* darkgray !important; */

                /* bootstrap.css */
                /* site.css */
                /* header .dropdown li > a:hover  , color */
                --bs-white: "@theme.MenuItemHoverColor !important";
                /* white !important;  */

                /* Log out */
                --bs-red: "#950606 !important";
    </style>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta name="application-name" content="@TenantSetter.CurrentTenant.TenantName" />
   
          
    <title>
        @ViewBag.Title | @TenantSetter.CurrentTenant.TenantName
    </title>

    <link rel="shortcut icon"
          href="@theme.LogoFilePath"
          type="image/x-icon" />

    <link href="@theme.LogoFilePath"
          rel="icon"
          type="image/x-icon" />

    <link rel="stylesheet"
          href="~/css/css/all.css"
          type="text/css">
    

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
   

    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">

   
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

    @{
        var tokens = Antiforgery.GetAndStoreTokens(Context);
    }

    <meta name="xsrf-token" content="@tokens.RequestToken" />
   
    @RenderSection( "Styles",required: false )
</head>

<body>

    <span id="pick"></span>

    @if (ViewBag.ExcludeHeader == true)
    {
        <header id="layoutHeaderContainer">
            @await Component.InvokeAsync("TopHeaderPanel")
        </header>

        <div id="layoutBodyContainer" class="body-content">

            <main>

                @RenderBody()

                <div class="fixed-action-btn">
                    <a class="btn-floating" href="#pick" role="link">
                        <i class="glyphicon glyphicon-menu-up"></i>
                    </a>
                </div>

            </main>

        </div>
    }
    else 
    {
        <header id="layoutHeaderContainer">

            @await Component.InvokeAsync("TopHeaderPanel")
            @await Component.InvokeAsync("MainHeaderPanel")
        @*     @await Component.InvokeAsync( "BottomHeaderPanel",new MenuObjectModel(TenantSetter.TenantStore)) *@

        </header>

      @*   @await Component.InvokeAsync("AdvancedSearch",new MenuObjectModel(true,TenantSetter.TenantStore)) *@

        @* @await Component.InvokeAsync("ShoppingCartNotification")  *@
       
        <div id="layoutBodyContainer" class="body-content">

            <main>
                    
                @RenderBody()
                   
                <div class="fixed-action-btn">

                    <a class="btn-floating" href="#pick" role="link">

                        <i class="glyphicon glyphicon-menu-up"></i>

                    </a>

                </div>

            </main>

        </div>
    }

    <footer>

        <div class="footer-content">

            <a> @SharedLocalizer["LinkResources"]</a> &nbsp; |

            <a style="color:white;" href="@Url.Action("Terms","Home")">@SharedLocalizer["LinkPrivacyAndTerms"]</a> &nbsp; |

            <a style="color:white;" href="@Url.Action("FAQ","Home")">@SharedLocalizer["LinkFaq"]</a> &nbsp; |

            <a style="color:white;" href="@Url.Action("Contact", "Home")">@SharedLocalizer["LinkContact"]</a> &nbsp; |

            © 2019 @SharedLocalizer["LinkPortalURL"], All rights reserved.

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/global-ajax.js" asp-append-version="true"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>

       

        //Home Page Links
        var changeLanguageUrl = '@Url.Action("Change", "Culture")' + '?LanguageAbbrevation=';

        //Home Page Links
        var simplesearchmarketurl = '@Url.Action("Market", "SimpleSearchMarket", new { pageLocation = "AllMarket", tab = "all", pageNumber = "1" })';

        //Everywhere
        var unwanteraccessurl = '@Url.Action("UnwantedAccessError", "Base")';
    </script>
        
    
    <script src="~/js/bootstrap-notify.js"></script>
    <script src="~/js/cookei.js"></script>
    <script src="~/js/language-chnage.js"></script>
        
    <script>
        $(function () {
            
            $('#ancorLanguage').on('show.bs.dropdown', function () { });

            $('#ancorLanguage').dropdown();

            $(".carousel").carousel({
                interval: 4000
            });
        });
    </script>

    @await RenderSectionAsync("scriptsapp", required: false)

</body>
</html>