@using Main.WebAppCore.DependentServices;

@{

if (User.IsInTenantRole(TenantSetter.ResolvedTenantId, "Admin"))
{
        <div class="dropdown">

            <a class="dropdown-toggle text-truncate"
                data-toggle="dropdown"
                role="button"
                aria-haspopup="true"
                data-userid="@User.GetUserId()"
                data-bs-toggle="dropdown">
                <i class="fa fa-user fa-1x"></i>
                <span>@User.Identity?.Name</span>
                <span class="caret"></span>
            </a>
                    
            <ul class="dropdown dropdown-menu" id="divMenuMyHomeSignin">

                <form asp-area="" asp-controller="Theme" asp-action="UpdateLogo" method="get" class="d-inline">
                    <button type="submit" class="dropdown-item dropdown-item-text icon-button btn btn-link w-100 text-start border-0 bg-transparent p-3">
                        <i class="fa fa-fw fa-edit"></i>
                        <span>
                            Update Logo 
                        </span>
                    </button>
                </form>

                @await Html.PartialAsync( "~/Views/Shared/Components/_MainMenuPage.cshtml" )
               
                @await Html.PartialAsync( "~/Views/Shared/Components/_MainMenuProduct.cshtml" )

                @await Html.PartialAsync( "~/Views/Shared/Components/_MainMenuAdPost.cshtml" )

                @await Html.PartialAsync( "~/Views/Shared/Components/_MainMenuProfile.cshtml" )
            
                @await Html.PartialAsync( "~/Views/Shared/Components/_MainMenuLogout.cshtml" )

        </ul>
    </div>
    }
}      