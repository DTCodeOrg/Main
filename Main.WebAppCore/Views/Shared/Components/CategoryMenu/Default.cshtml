@model MenuObjectModel
@{
    var InitText = !String.IsNullOrEmpty(Model.CategoryText) ? Model.CategoryText : @SharedStringLocalizer["CateAccordionViewByMarkets"];
}

 <!-- Dropdown Component -->
 <div class="dropdown-trigger">

      <button class="nav-btn dropdown-btn">Categories ▼</button>
        <!-- Level 1 Menu -->
     
          <ul class="dropdown-menu">
              
        
              

                @foreach (var category in Model.ListCategory.ToList())
                {
        
                        <li class="category-item">

                                 <a href="#" class="category-link"> @category.Text </a>
                      
                                  <!-- Level 2 Menu -->
                                  <ul class="subcategory-menu">

                                      <li class="fixed-submenu-title"> @category.Text </li>

                                       @{

                                            var itemList = 
                                            Model.ListSubCategory.Where( a => a.ParentID == category.ValueID ).ToList( );

                                            if ( itemList == null )
                                            {
                                                continue;
                                            }

                                        }

                                         @foreach ( var subcategory in itemList.ToList() )
                                         {

                                                <li><a href="#" class="subcategory-link"> @subcategory.Text </a></li>
                                      
                                         }

                                  </ul>

                        </li>
               }
        </ul>
    </div>   
















