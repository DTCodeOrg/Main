@{
    ViewData["Title"] = "Update Tenant Logo";
}

<div class="container">

    <div class="row">

        <div class="col-md-3">
        </div>

        <div class="col-md-6">

            <h2>Update Logo</h2>
            
            <div class="form-group mb-3">
                
                    <label for="logoFile" class="form-label">Select New Logo Image:</label>

                    <form asp-action="UpdateLogo"
                            asp-controller="Theme"
                            asp-area=""
                            method="post"
                            enctype="multipart/form-data">

                        <label >Select File:</label>
                      
                        <input class="form-control" type="file" id="logoFile" name="logoFile" />
                        <br />
                        <br />
                        <button type="submit">Upload</button>

                    </form>

            </div>

           
            <div class="mb-3">

                <p>Current Logo:</p>
                   
                <img src="@Model.CurrentLogoFileName" 
                    alt="Current Logo" 
                    style="max-height: 100px; display: block;" />

            </div>
          

            <button type="submit" class="btn btn-primary">Upload and Save</button>
           
            <a asp-action="Index" asp-controller="Home" asp-area="" class="btn btn-secondary">Cancel</a>

        </div>

    </div>

</div>