
@{
    var tenantName = TenantSetter.CurrentTenant.TenantName;
    var title = $"{ tenantName } Logo";
    ViewData["Title"] = title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.ExcludeHeader = true;
    var path = ViewData["LogoPath"] as string;

    if (string.IsNullOrEmpty(path))
    {
        path = Model.CurrentLogoFileName;
    }
}


<div class="container">

    <div class="gap"></div>

     <div class="page-header">

        <div class="header-text">

            <h1>Manage Tenant Logo</h1>

            <p>View, update logo for @tenantName.</p>

        </div>

    </div>

    <div class="card" style="padding: 20px;">

            <h4>Update Logo</h4>

            <div class="gap">
            </div>
               
            <p class="form-label">
                Current Logo:
            </p>
                   
            <img src="@path" 
                alt="Current Logo" class ="img-thumbnail"
                style="height: 100px;width: 100px;max-width: 100px;max-height: 100px; display: block;" />

            <div class="gap"></div>
            <div class="gap"></div>
            
            <div class="form-group">
                <br />
                <label for="logoFile" class="form-label">
              Select New Logo Image:
                </label>

              

                <form   asp-action="UpdateLogo"
                        asp-controller="Theme"
                        asp-area=""
                        class="icon-button"
                        method="post"
                        enctype="multipart/form-data"
                        type="submit">

                   

                    <input type="file" id="logoFile" name="logoFile" />

                     <button class="icon-button" type="submit">
                       

                            <span>
                                Upload
                            </span>

                        </button>
                 </form>

                   <br />
                    

                 

                       

                   
                   

              
            </div>

       

    </div>

</div>