@model PostViewModel

<div class="image-content" draggable="false" style="height:600px;width:100%;overflow:hidden;">
    <div title="Product Image" draggable="false">
        <a class="thumbnail" draggable="false">
            @if (Model != null)
            {
            
                <img src= "@Model.FilePath"
                     class="img-responsive new-post-mobile-image"
                     alt="Product image"
                     style="height:100%;width:100%; object-fit: cover; object-position: center;"
                     draggable ="false" />
            }
            else
            {
                <img src="~/lib/Images/Home/camera.png"
                     class="img-responsive new-post-mobile-image"
                     alt="Product image is not available"
                      style="height:100%;width:100%; object-fit: cover; object-position: center;"
                     draggable="false" />
            }
        </a>
    </div>
</div>





