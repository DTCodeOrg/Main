@model PanelViewModel

<div class="container">

    <h4 class="sub-title text-justify">

        @if( !string.IsNullOrEmpty(Model.PanelTitle) )
        {
            <span class="text-info-emphasis">

                <i class="fa fa-caret-right fa-fw"> </i>

                @Model.PanelTitle

            </span>
        }

    </h4>

    <div class="row">

        @{
            foreach ( var product in Model.ListPosts.ToList())
            {
                <div class="col-md-3 col-sm-3 col-lg-3 col-xs-3 card">
                           
                    <a class="thumbnail only-image">

                        @if ( product != null )
                        {
                            @await Html.PartialAsync( "~/Areas/PageContent/Views/Pages/Images/_Image4X.cshtml", product )
                        }
                        else
                        {
                            @await Html.PartialAsync( "~/Areas/PageContent/Views/Pages/Images/_Image4X.cshtml", product)         
                        }
                    </a>


                    <div class="caption card-body">

                        <h5 class="truncate text-bg-success card-title">
                           
                            <h5 class="truncate text-bg-success card-title">
                                @(product?.PostTitle ?? "Untitled Post")
                            </h5>


                        </h5>

                        <p class="fa-dollar text-info-emphasis card-text">
                      
                            @if ( product is not null )
                            {
                                <span>@(product.Price?.ToString("F2") ?? "0.00") Taka</span>
                            }
                            else
                            {
                                <span>Price unavailable</span>
                            }
                        </p>

                        <span>

                            <i class="fa fa-plus fa-fw"></i>

                            ADD TO CART

                        </span>

                    </div>
                
                </div>
            }
        }

    </div>

</div>