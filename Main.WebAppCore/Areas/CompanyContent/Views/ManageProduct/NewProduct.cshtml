@model ProductViewModel
@{
    ViewBag.Title = "New Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.ExcludeHeader = true;
}

<div id="newProductMainContainer" class="container">
    @await Html.PartialAsync("~/Areas/CompanyContent/Views/ManageProduct/_NewProduct.cshtml", Model)
</div>

@section scriptsapp { 

@await Html.PartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml")

<script>

    var PAGE_NAME = '@Model.PageName';
    var getSubCategoryURL = '@Url.Action("GetSubCategories", "ManageProduct")';
    var uploadImageURL = '@Url.Action("UploadImage", "ManageProduct")';
    var loadImageURL = '@Url.Action("LoadImage", "ManageProduct")';
    var removeProductImageURL = '@Url.Action("ImageRemove", "ManageProduct")?id=';
    var notify = $.notify;


$(document).ready(function () {

    
    $('#btnLoadImage').on('click', function () {
        $('#fileInput').click();
    });

    
    $('.upload-container form').on('submit', function (e) {

        e.preventDefault(); 

        var formData = new FormData(this);

        var $form = $(this);

        $.ajax({
            url: $form.attr('action'),
            type: $form.attr('method'),
            data: formData,
            contentType: false, 
            processData: false, 
            success: function (responseHtml) {
                        
                $('#imagePanelContainer').append(responseHtml);
                        
                $('#fileInput').val('');

            },
            error: function (xhr) {

                alert("An error occurred during upload. Please ensure it is a valid image file.");
            
            }
        });
    });

            
    document.getElementById("myMainForm").addEventListener("submit", function (e) {
           
        e.preventDefault(); 
                
        const formData = new FormData(this);
                    
        var that = $(this);
    
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
        .then(response => {
            
            return response.json().then(data => {
              
                      console.log("Status Code:", response.status);

                      console.log("JSON Data:", data);
      
                      if (response.status === 200) 
                      {
                            window.location.href = data.urlGo;
                      }
                      else if (response.status === 400) 
                      {
                            return;
                      }

                      return;
                });
        })
        .catch(error => {
            return;
        });
    });


    $(document).on("click", ".btn-remove-image", function () {

            var that = this;
            var id = $(that).data("id");
            var rem = $(that).closest(".image-content");

            $(rem).remove();

            $.ajax({
                url: removeProductImageURL + id,
                type: 'DELETE',
                dataType: 'json',
                processData: false,
                cache: false,
                async: true,
                success: function (response) {
                    console.log(response);
                },
                error: function (error) {
                    console.log(error);
                }
            });
        });
}); 
</script>
}