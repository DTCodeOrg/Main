@model ProductViewModel

@{
    var tenantName = TenantSetter.CurrentTenant.TenantName;
    var title = $"{ tenantName } Products";
    ViewData["Title"] = title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.ExcludeHeader = true;
}

<div id="editAdminPostMainView" class="container">

     <div class="page-header">

    <div class="header-text">

        <h1>Tenant Product</h1>
            
        <p>View, edit, or delete products for @tenantName.</p>

    </div>

    <div class="header-actions">
            
        <a class="dropdown-item dropdown-item-text icon-button"
            asp-area="CompanyContent"
            asp-controller="ManageProduct"
            asp-action="NewProduct">

            <i class="fa fa-fw fa-plus"></i>

            <span class="action-text">
                Add Product
            </span>

        </a>

    </div>

</div>
    @await Html.PartialAsync("~/Areas/CompanyContent/Views/ManageProduct/_EditProduct.cshtml", Model)
</div>

@section scriptsapp {

    @await Html.PartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml")


    <script>
        var notify = $.notify;

        PAGE_NAME = '@Model.PageName';

        var getSubCategoryURL = '@Url.Action("GetSubCategories", "ManageProduct")?id=';
        var uploadImageURL = '@Url.Action("UploadImage", "ManageProduct")';
        var loadImageURL = '@Url.Action( "LoadImage","ManageProduct" )';
        var removeImageShortContentURL = '@Url.Action("ImageRemove", "ManageProduct")?id=';

        var SUCCESS = "Success";
        var IMAGE_LOAD_SUCCESSFUL = "Image load successful!";

        

        $(document).ready(function () {
            

            $('.upload-container form').on('submit', function (e) {

                e.preventDefault(); 

                var formData = new FormData(this);

                var $form = $(this);

                $.ajax({
                    url: $form.attr('action'),
                    type: $form.attr('method'),
                    data: formData,
                    contentType: false, 
                    processData: false, 
                    success: function (responseHtml) {
                        
                        $('#imagePanelContainer').append(responseHtml);
                        
                        $('#fileInput').val('');

                    },
                    error: function (xhr) {

                        alert("An error occurred during upload. Please ensure it is a valid image file.");
            
                    }
                });
            });
           

            document.getElementById("myMainFormEdit").addEventListener("submit", function (e) {
                
                e.preventDefault();
                
                const formData = new FormData(this);
    
                fetch(this.action, {
                    method: 'POST',
                    credentials: 'same-origin',
                    body: formData
                })
                .then(response => {
            
                    return response.json().then(data => {
              
                              console.log("Status Code:", response.status);
                              console.log("JSON Data:", data);
      
                              if (response.status === 200)
                              {
                                    window.location.href = data.urlGo;
                              }
                              else if (response.status === 400)
                              {
                                    return;
                              }
                              return;
                        });
                })
                .catch(error => {
                    console.error("Network or parsing error:", error);
                    return;
                });
            });
           

            // Ensure this code is placed inside an event handler, for example:
            $(document).on("click", ".btn-remove-image", function () {

                var that = this;

                // 1. Fixed camelCase data attribute reading
                var id = $(that).data("fileid");

                var postId = $(that).data("postid");

                // 2. Fixed camelCase data attribute reading to match standard HTML behavior
                var fileName = $(that).data("filename"); 

                var rem = $(that).closest(".image-content");
                $(rem).remove();

                // 3. Fixed missing opening parenthesis for $.ajax and updated type
                $.ajax({
                    url: removeImageShortContentURL + "?id=" + id + "&postId=" + postId + "&fileName=" + fileName,
                    type: 'POST', // Changed from DELETE to POST for standard ASP.NET model binding
                    dataType: 'json',
                    processData: false,
                    cache: false,
                    async: true,
                    success: function (response) {
                        console.log(response);
                    },
                    error: function (error) {
                        console.log(error);
                    }
                }); // 4. Fixed missing closing bracket if this ends the click function
            });


        });
    </script>
}