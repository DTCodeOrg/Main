@model ImageFile

<div class="image-content">
    <div title="Product Image">
        <a class="thumbnail">
            @if (Model != null && Model.RelativeFilePath.Length > 0)
            {
                
                <img src="@Model.RelativeFilePath"
                     class="img-responsive new-post-mobile-image"
                     alt="Product image"
                     style="max-height:140px; max-width:100%;width:100%;" />
            }
            else
            {
                <img src="~/lib/Images/Home/camera.png"
                     class="img-responsive new-post-mobile-image"
                     alt="Product image is not avaliable"
                     style="max-height:140px; max-width:100%;width:100%;" />
                <span id="infoErrorUpload1" style="display:none;color:red;font-size:smaller;">
                    File size must be less than 7MB!
                </span>
            }
        </a>
    </div>

    @{
        int postId = Model?.PostID ?? 0;
        string fileName = Model.FileName!;
    }

    <button type="button"
            class="light-button btn-remove-image"
            data-fileName="@fileName"
            data-postid="@postId"
            data-id="@Model.FileID">
        REMOVE
    </button>
</div>