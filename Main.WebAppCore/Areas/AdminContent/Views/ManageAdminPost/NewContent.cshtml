@model AdminPostViewModel

@{
    ViewBag.Title = SharedLocalizer["ViewBagTitleNewPost"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.ExcludeHeader = true;
}

<div id="newAdminPostMainView" class="container">
    @await Html.PartialAsync( "~/Areas/AdminContent/Views/ManageAdminPost/_NewContent.cshtml",Model )
</div>

@section scriptsapp {

    @await Html.PartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml")

<script>

    var PAGE_NAME = '@Model.PageName';

    var  SUCCESS = "SUCCESS";
            
    var IMAGE_LOAD_SUCCESSFUL= "SUCCESSFULL!";

    var imageLoadURL = '@Url.Action( "LoadImage","ManageAdminPost" )';

    var imageUploadURL = '@Url.Action( "UploadImage","ManageAdminPost" )';

    var removeImageShortContentURL = '@Url.Action("ImageRemove", "ManageAdminPost")?id=';

    var notify = $.notify;

    function LoadImageNewAdminContent() {
        
        $.ajax({
                type: 'GET',
                url: imageLoadURL,
                dataType: 'html', // Tells jQuery to expect raw HTML string output from the partial view
                success: function (htmlResult) {
                    console.log(htmlResult);
                    // htmlResult contains the compiled HTML markup of your "_Image" partial view
        
                    // Option A: Append the image markup to the bottom of the container
                    $('#imageContainerDiv').append(htmlResult);

                notify({
                    type: 'success',
                    message: '<strong><i class="fa fa-thumbs-up"></i>&nbsp;' + SUCCESS + '</strong> ' + IMAGE_LOAD_SUCCESSFUL,
                    allow_dismiss: true,
                    placement: {
                        from: "top",
                        align: "right"
                    },
                    delay: { show: 10, hide: 10 },
                    template: '<div data-notify="container" class="col-xs-11 col-sm-3 alert alert-{0}" role="alert">' +
                        '<button type="button" inert class="close" data-notify="dismiss">×</button>' +
                        '<span data-notify="icon"></span>' +
                        '<span data-notify="title">{1}</span>' +
                        '<span data-notify="message">{2}</span>' +
                        '</div>'
                });
            },
            error: function (error) {
                console.log(error);
            }
        });
    }


    $(document).ready(function () {

        $("#myMainForm").valid();

        $('#btnUpload').click ( function () {

            var formData = new FormData();
            formData.append("file", $("#fileInput")[0].files[0]);

            // 2. Execute the AJAX request
            $.ajax({
                url: imageUploadURL, // Update with your actual Area/Controller path
                type: 'POST',
                data: formData,
                processData: false, // Prevents jQuery from converting the FormData object into a query string
                contentType: false, // Prevents jQuery from setting a default Content-Type header (forces multipart/form-data)
                dataType: 'json',   // Tells jQuery to automatically parse the response text into a JavaScript JSON object
                success: function (response) {
                    // Triggers when .NET returns an Ok() (HTTP 200) response
                    // .NET 8 automatically lowercases the properties to camelCase ("success" and "message")
                    if (response.success) {

                        LoadImageNewAdminContent();

                        console.log("Success message from server:", response.message);

                        alert("Perfect! " + response.message);
                        // Your logic here (e.g., refresh a list, clear the input)
                    } else {
                        // Backup validation check
                        alert("Upload failed: " + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    // Triggers when .NET returns BadRequest() (HTTP 400) or StatusCode(500)
                    // Access the JSON payload stored inside the xhr (XMLHttpRequest) object
                    var errorResponse = xhr.responseJSON;

                    if (errorResponse && errorResponse.message) {
                        //console.error("Server validation error:", errorResponse.message);
                        alert("Error: " + errorResponse.message);
                    } else {
                        //console.error("Critical error:", error);
                        alert("A critical system error occurred. Please try again.");
                    }
            }
        });
        });

           
        document.getElementById("myMainForm").addEventListener("submit", function (e) 
        {
            e.preventDefault(); 

            const form = e.target;

            const formData = new FormData(form);
             
            fetch(form.action, 
            {
                method: 'POST',
                credentials: 'same-origin',
                body: formData
            })
            .then(response => {
            
                return response.json().then(data => {
              
                    console.log("Status Code:", response.status);
                    console.log("JSON Data:", data);
      
                    if (response.status === 200)
                    {
                        window.location.href = data.urlGo;
                    }
                    else if (response.status === 400)
                    {
                        return;
                    }
                    return;
                });

            })
            .catch(error => {
                console.error("Network or parsing error:", error);
                return;
            } );
        });


        $(document).on("click", ".btn-remove-image", function () {

            var that = this;

            var id = $(that).data("id");

            var rem = $(that).closest(".image-content");

            $(rem).remove();

            $.ajax({
                url: removeImageShortContentURL + id,
                type: 'DELETE',
                dataType: 'json',
                processData: false,
                cache: false,
                async: true,
                success: function (response) {
                    console.log(response);
                },
                error: function (error) {
                    console.log(error);
                }
            });
        });
    });
</script>
}