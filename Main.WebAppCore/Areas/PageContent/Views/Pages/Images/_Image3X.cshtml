@model PostViewModel

<div class="image-content" draggable="false">
    <div title="Product Image" draggable="false">
        <a class="thumbnail" 
            draggable="false"  
            href = "@Url.Action("Details", "ManageProduct", new { area = "CompanyContent", id = Model.RootID })"
            target = "_blank" 
            rel = "noopener noreferrer"class="thumbnail" 
            draggable="false"  
            href = "@Url.Action("Details", "ManageProduct", new { area = "CompanyContent", id = Model.RootID })"
            target = "_blank" 
            rel = "noopener noreferrer">
            @if (Model != null)
            {
               <img src= "@Model.FilePath"
                     class="img-responsive new-post-mobile-image"
                     alt="Product image"
                     style="height:217px;width:100%;"
                     draggable ="false" />
            }
            else
            {
                <img src="~/lib/Images/Home/camera.png"
                     class="img-responsive new-post-mobile-image"
                     alt="Product image is not available"
                     style="height:217px;width:100%;"
                     draggable="false" />
            }
        </a>
    </div>
</div>





