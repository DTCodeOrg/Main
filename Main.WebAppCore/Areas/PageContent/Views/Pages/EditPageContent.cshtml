@model PageViewModel

@{
    ViewData["Title"] = "Edit Panels";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.ExcludeHeader = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/panel-up-down.css" />
}

<div class="container"> 

        <div data-label="Action" class="image-field col-md-12 col-xs-12 col-sm-12 col-lg-12">

        <a title="List of Pages"
                class="icon-button btn-lg flex"
                href="@Url.Action("Index", "Pages", new { Area = "PageContent" })">
            <i class="fa fa-list"></i>
            <span class="action-text">List Pages</span>
        </a>

        <a title="View Page"
            class="icon-button btn-lg flex"
                href="@Url.Action("PreviewPageContent", "Pages", new { Area = "PageContent", id = Model.PageID })">
            <i class="fa fa-eye"></i> 
            <span class="action-text">View Page</span>
        </a>

         <a title="New Panel"
            class="icon-button btn-lg flex"
                href="@Url.Action("NewProductPanel", "Pages", new { Area = "PageContent", id = Model.PageID })">
            <i class="fa fa-plus"></i>
            <span class="action-text">New Panel</span>
        </a>

    </div>

    <div class="gap"></div>
    <div class="gap"></div>

    <h4 class="card-title">EDIT PANELS - (@Model.PageName)</h4>

    <div class="gap"></div>

</div>

<div class="list-panel">


    @{
        

        foreach(var model in Model.ListPagePanels.ToList())
        {

            if ( model.PanelTemplate == EnumPanelTemplate.ProductSixer)
            {
                @await Html.PartialAsync( "~/Areas/PageContent/Views/Pages/EditPanels/_ProductPanel6X.cshtml",model )
            }
            else if ( model.PanelTemplate == EnumPanelTemplate.ProductQuadruple )
            {
                @await Html.PartialAsync( "~/Areas/PageContent/Views/Pages/EditPanels/_ProductPanel4X.cshtml",model )
            }
            else if ( model.PanelTemplate == EnumPanelTemplate.ProductTriangle )
            {
                @await Html.PartialAsync( "~/Areas/PageContent/Views/Pages/EditPanels/_ProductPanel3X.cshtml",model )
            }
            else if ( model.PanelTemplate == EnumPanelTemplate.ProductDouble )
            {
                @await Html.PartialAsync( "~/Areas/PageContent/Views/Pages/EditPanels/_ProductPanel2X.cshtml",model )
            }
            else if ( model.PanelTemplate == EnumPanelTemplate.ProductSingle )
            {
                @await Html.PartialAsync( "~/Areas/PageContent/Views/Pages/EditPanels/_ProductPanel1X.cshtml",model )
            }
        }
    }
</div>


@section scriptsapp 
{
    <script src="~/js/panel-step-updown.js"></script>

    <script>
        $(function() {
        
            urlDeletePanel = "@Url.Action("DeletePanel", "Pages", new { area = "PageContent" })";

            urlUpdatePanelPositon = "@Url.Action("UpdatePositions", "Pages", new { area = "PageContent" })";

        });
    </script>
    
}